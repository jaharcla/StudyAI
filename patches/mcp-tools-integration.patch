--- /dev/null
+++ b/src/charts/VegaChartTool.tsx
@@ -0,0 +1,65 @@
+import { useRenderTool } from "@copilotkit/react-core/v2";
+import { useEffect, useRef, useState } from "react";
+import vegaEmbed, { type VisualizationSpec } from "vega-embed";
+import { buildChartSpec, CHART_DATASET, resolveChartFields, vegaChartSchema, type VegaChartArgs } from "./vega-contract";
+
+function Chart({ args }: { args: VegaChartArgs }) {
+  const container = useRef<HTMLDivElement>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    const element = container.current;
+    if (!element) return;
+    let disposed = false;
+    let view: { finalize(): void } | undefined;
+    setError(null);
+    // Named data sources are supplied through Vega-Lite's `datasets`, so the
+    // renderer never fetches a URL and the spec itself stays clean.
+    // vega-embed treats a string spec as a URL, so pass the validated object.
+    // The schema guard above is what makes this assertion safe.
+    const spec = { ...buildChartSpec(args), datasets: { [CHART_DATASET]: args.data } } as unknown as VisualizationSpec;
+    vegaEmbed(element, spec, { actions: false, renderer: "svg" })
+      .then((result) => {
+        if (disposed) result.view.finalize();
+        else view = result.view;
+      })
+      .catch((reason: unknown) => {
+        if (!disposed) setError(reason instanceof Error ? reason.message : "The chart could not be rendered.");
+      });
+    return () => {
+      disposed = true;
+      view?.finalize();
+    };
+  }, [args]);
+
+  return (
+    <div className="studyai-vega-chart" data-testid="vega-chart">
+      <div ref={container} />
+      {error ? <p role="alert" data-testid="vega-chart-error">{error}</p> : null}
+    </div>
+  );
+}
+
+export function VegaChartToolRenderer() {
+  // Dev-only bridge so a browser test can render a fixture through the same
+  // component path a completed tool call uses. It is stripped from prod builds.
+  const [fixture, setFixture] = useState<VegaChartArgs | null>(null);
+  useEffect(() => {
+    if (!import.meta.env.DEV) return;
+    const host = window as Window & { __studyaiVegaChart?: (args: VegaChartArgs) => void };
+    host.__studyaiVegaChart = setFixture;
+    return () => { delete host.__studyaiVegaChart; };
+  }, []);
+
+  useRenderTool({
+    name: "show_vegalite_chart",
+    parameters: vegaChartSchema,
+    render: ({ status, parameters }) => {
+      if (status !== "complete") return <p data-testid="vega-chart-status">Rendering chart…</p>;
+      const parsed = vegaChartSchema.safeParse(parameters);
+      if (!parsed.success) return <p role="alert" data-testid="vega-chart-error">Chart arguments were invalid.</p>;
+      return <Chart args={resolveChartFields(parsed.data)} />;
+    },
+  }, []);
+  return fixture ? <Chart args={fixture} /> : null;
+}
diff --git a/src/charts/vega-contract.ts b/src/charts/vega-contract.ts
new file mode 100644
index 0000000..149ed32
--- /dev/null
+++ b/src/charts/vega-contract.ts
@@ -0,0 +1,48 @@
+import { z } from "zod";
+
+// One contract shared by the server tool and the chat renderer. The model
+// supplies chart parameters, not a nested Vega-Lite document: a small local
+// model reliably picks fields and rows but not a large nested JSON spec.
+const fieldType = z.enum(["nominal", "ordinal", "quantitative", "temporal"]);
+
+export const vegaChartSchema = z.object({
+  mark: z.enum(["bar", "line", "point", "area"]).default("bar"),
+  title: z.string().trim().min(1).max(160).optional(),
+  xField: z.string().trim().min(1).max(80),
+  yField: z.string().trim().min(1).max(80),
+  xType: fieldType.default("nominal"),
+  yType: fieldType.default("quantitative"),
+  data: z.array(z.record(z.string(), z.unknown())).min(1).max(200),
+}).strict();
+
+export type VegaChartArgs = z.infer<typeof vegaChartSchema>;
+
+export const CHART_DATASET = "table";
+
+// A small model often names fields after the question (e.g. "A", "B") rather
+// than the row keys it supplied. Resolve them from the data instead of
+// rejecting the call, and infer a sane type from the first row's values.
+export function resolveChartFields(args: VegaChartArgs): VegaChartArgs {
+  const keys = Object.keys(args.data[0] ?? {});
+  if (keys.length === 0) return args;
+  const infer = (field: string, fallback: VegaChartArgs["xType"]): VegaChartArgs["xType"] => {
+    const value = args.data[0]?.[field];
+    return typeof value === "number" ? "quantitative" : value === undefined ? fallback : "nominal";
+  };
+  const xField = keys.includes(args.xField) ? args.xField : keys[0];
+  const yField = keys.includes(args.yField) ? args.yField : (keys.find((key) => key !== xField) ?? xField);
+  return { ...args, xField, yField, xType: infer(xField, args.xType), yType: infer(yField, args.yType) };
+}
+
+export function buildChartSpec(args: VegaChartArgs) {
+  return {
+    $schema: "https://vega.github.io/schema/vega-lite/v6.json",
+    mark: args.mark,
+    ...(args.title ? { title: args.title } : {}),
+    encoding: {
+      x: { field: args.xField, type: args.xType },
+      y: { field: args.yField, type: args.yType },
+    },
+    data: { name: CHART_DATASET },
+  };
+}
