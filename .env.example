OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:latest
GROQ_API_KEY=
# Optional server-side key for the Google Fact Check Tools API.
GOOGLE_FACT_CHECK_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# groq runs without Ollama fallback; auto prefers Groq and falls back when available.
TUTOR_PROVIDER=auto
TUTOR_CONTEXT_BUDGET=16384
TUTOR_MODEL_CONTEXT_LIMITS={}
TUTOR_MAX_COMPLETION_TOKENS=2048
TUTOR_MAX_PROVIDER_CALLS=3
TUTOR_MAX_GROQ_COST_USD=0.02
TUTOR_GROQ_RETRIES=0
TUTOR_GROQ_INPUT_USD_PER_1M=0.15
TUTOR_GROQ_OUTPUT_USD_PER_1M=0.60
AI_GROQ_CONCURRENCY=2
AI_OLLAMA_CONCURRENCY=2
AI_MAX_QUEUED_REQUESTS=8
AI_REQUEST_TIMEOUT_MS=120000
CANVAS_INFERENCE_PROVIDER=groq
LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:8133
WEB_PORT=5183
RUNTIME_PORT=8210
DATA_PORT=8211
AGENT_PORT=8133
