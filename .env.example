OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:latest
GROQ_API_KEY=
# Optional server-side key for the Google Fact Check Tools API.
GOOGLE_FACT_CHECK_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional local OpenAI-compatible gateway (OmniRoute, Strata, or any compatible gateway).
# Uncomment any OMNIROUTE_* value to opt the gateway into TUTOR_PROVIDER=auto fallback.
# OMNIROUTE_MODEL selects a gateway model or combo. Use a target that advertises
# tool_calling for the Tutor's canvas tools (free combos like free-stack/auto/* do not).
# Many gateways require auth even on loopback; set the real key in .env, never here.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=agnes/agnes-2.5-flash-high
# Canvas OCR needs a vision-capable target; leave empty to reuse OMNIROUTE_MODEL.
# CANVAS_OMNIROUTE_MODEL=
# Tutor provider: groq | auto | ollama | omniroute (openai-compatible) |
# opencode-go | openrouter | gemini. Explicit modes never fall back.
TUTOR_PROVIDER=groq
TUTOR_CONTEXT_BUDGET=16384
TUTOR_MODEL_CONTEXT_LIMITS={}
TUTOR_MAX_COMPLETION_TOKENS=2048
TUTOR_MAX_PROVIDER_CALLS=3
TUTOR_MAX_GROQ_COST_USD=0.02
TUTOR_GROQ_RETRIES=0
TUTOR_GROQ_INPUT_USD_PER_1M=0.15
TUTOR_GROQ_OUTPUT_USD_PER_1M=0.60
AI_GROQ_CONCURRENCY=2
AI_OLLAMA_CONCURRENCY=2
AI_MAX_QUEUED_REQUESTS=8
AI_REQUEST_TIMEOUT_MS=120000
CANVAS_INFERENCE_PROVIDER=auto
CANVAS_OCR_PROVIDER=auto
# Ordered fallback chain for auto mode. Ollama is opt-in and never in this chain by default.
CANVAS_PROVIDER_CHAIN=groq,opencode-go,openrouter,gemini
CANVAS_OCR_MAX_REGIONS=6
VITE_CANVAS_OCR_MAX_REGIONS=6
# Math-only boards use a whole-expression crop and a LaTeX OCR model.
# Leave CANVAS_MATH_OCR_PROVIDER empty to use the automatic chain: gemini -> openrouter -> opencode-go -> groq.
CANVAS_MATH_OCR_PROVIDER=
GOOGLE_AI_API_KEY=
CANVAS_GEMINI_MODEL=gemini-3.1-flash-lite
CANVAS_GEMINI_MATH_OCR_MODEL=
CANVAS_MATH_OCR_MODEL=google/gemini-3.1-flash-lite
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_GO_API_KEY=
# Optional stable session ID for OpenCode Go routing; any UUID works.
OPENCODE_GO_SESSION=
CANVAS_OPENCODE_GO_MODEL=qwen3.8-flash
CANVAS_OPENCODE_GO_OCR_MODEL=qwen3.8-flash
CANVAS_OPENCODE_GO_MAX_REQUESTS_PER_DAY=20
OPENROUTER_API_KEY=
CANVAS_OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
CANVAS_OPENROUTER_OCR_MODEL=qwen/qwen3-vl-8b-instruct
CANVAS_OPENROUTER_MAX_REQUESTS_PER_DAY=50
# Canvas recognition: off | baseline | clip | auto. auto tries CLIP and falls back to the geometry baseline.
CANVAS_RECOGNITION=auto
CANVAS_RECOGNITION_MIN_CONFIDENCE=0.18
CANVAS_RECOGNITION_MIN_MARGIN=0.03
# Set to 1 to preload the CLIP runtime at data-API start; left off for tests and short-lived scripts.
CANVAS_CLIP_WARMUP=0
CANVAS_MODEL_CACHE=data/models
LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:8133
WEB_PORT=5183
RUNTIME_PORT=8210
DATA_PORT=8211
AGENT_PORT=8133

CANVAS_GROQ_MAX_COMPLETION_TOKENS=8192

# Cloud canvas OCR request timeout in ms (clamped 1000-60000, default 30000).
# A hung primary OCR provider falls back to the next in the chain at this bound.
CANVAS_OCR_TIMEOUT_MS=30000

# Optional hosted credits rail (StudyAI Credits). Both values are build-time
# public config, not secrets; leave them empty to hide the hosted provider.
# The Worker URL and client marker must match hosted/wrangler.toml and the
# Worker's STUDYAI_CLIENT_TOKEN secret.
# VITE_CREDITS_API_URL=https://studyai-credits.<account>.workers.dev
# VITE_STUDYAI_CLIENT_TOKEN=
# Paid rail is dormant. Set to 1 to expose the credits provider, credits panel
# and Stripe support panel in Settings. Requires the two values above plus a
# funded Worker; do not enable without partner approval.
# VITE_STUDYAI_PAID_ENABLED=0